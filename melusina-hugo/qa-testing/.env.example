# OpenRouter API Configuration
# Get your free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Free-tier model routing (both $0/M tokens):
# BRAIN = Trinity Large Preview (400B MoE, 13B active, 131K ctx, text reasoning)
# EYES  = Nemotron Nano 12B 2 VL (12B, 128K ctx, multimodal vision)
MODEL_BRAIN=openrouter:arcee-ai/trinity-large-preview:free
MODEL_EYES=openrouter:nvidia/nemotron-nano-12b-v2-vl:free

# AiTX.pro Hugo dev server (default: http://localhost:4175)
# BASE_URL=http://localhost:4175
