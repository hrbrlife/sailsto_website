{
  "name": "hrbr-qc",
  "version": "1.0.0",
  "private": true,
  "description": "Centralized QC suite for all HRBR.LIFE portfolio sites",
  "scripts": {
    "check": "node run.js --all",
    "check:sailsto": "node run.js --site sailsto",
    "check:kyclat": "node run.js --site kyclat",
    "check:melusina": "node run.js --site melusina",
    "check:instakycapp": "node run.js --site instakycapp",
    "check:hrbr": "node run.js --site hrbr",
    "links": "node run.js --all links",
    "images": "node run.js --all images",
    "glossary": "node run.js --all glossary",
    "seo": "node run.js --all seo",
    "content": "node run.js --all content",
    "contrast": "node run.js --all contrast",
    "install:browsers": "npx playwright install chromium"
  },
  "dependencies": {
    "playwright": "^1.40.0"
  }
}
