    <item>
      <title>About Us</title>
      <link>http://localhost:1313/company/about/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>http://localhost:1313/company/about/</guid>
      <description>&lt;section class=&#34;page-hero&#34;&gt;&#xA;    &lt;span class=&#34;section-label&#34;&gt;Our Story&lt;/span&gt;&#xA;    &lt;h1 class=&#34;section-title&#34;&gt;Building the Future of Capital Markets&lt;/h1&gt;&#xA;    &lt;p class=&#34;section-desc&#34;&gt;We&#39;re bridging the gap between blockchain innovation and traditional finance infrastructure, making compliant securities accessible to everyone.&lt;/p&gt;&#xA;&lt;/section&gt;&#xA;&lt;section class=&#34;detail-section&#34;&gt;&#xA;    &lt;div class=&#34;detail-container&#34;&gt;&#xA;        &lt;div class=&#34;detail-grid&#34;&gt;&#xA;            &lt;div class=&#34;detail-content&#34;&gt;&#xA;                &lt;h2&gt;Our Mission&lt;/h2&gt;&#xA;                &lt;p&gt;Traditional capital markets are gatekept by high costs, slow processes, and geographic limitations. Meanwhile, blockchain technology offers unprecedented efficiency but operates in regulatory gray zones.&lt;/p&gt;&#xA;                &lt;p&gt;We built Sails.to to solve this paradox — a hybrid infrastructure that delivers the best of both worlds: blockchain&#39;s speed and accessibility with traditional finance&#39;s legal clarity and institutional trust.&lt;/p&gt;</description>
    </item>
    <item>
      <title>Contact Us</title>
      <link>http://localhost:1313/company/contact/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>http://localhost:1313/company/contact/</guid>
      <description>&lt;section class=&#34;page-hero&#34;&gt;&#xA;    &lt;span class=&#34;section-label&#34;&gt;Get In Touch&lt;/span&gt;&#xA;    &lt;h1 class=&#34;section-title&#34;&gt;Let&#39;s Talk&lt;/h1&gt;&#xA;    &lt;p class=&#34;section-desc&#34;&gt;Whether you&#39;re ready to launch, exploring options, or have questions, we&#39;re here to help.&lt;/p&gt;&#xA;&lt;/section&gt;&#xA;&lt;section class=&#34;contact-section&#34;&gt;&#xA;    &lt;div class=&#34;contact-container&#34;&gt;&#xA;        &lt;div class=&#34;contact-grid&#34;&gt;&#xA;            &lt;div class=&#34;contact-info&#34;&gt;&#xA;                &lt;div class=&#34;contact-card&#34;&gt;&#xA;                    &lt;span class=&#34;icon-wrapper&#34;&gt;&lt;svg&gt;&lt;use href=&#34;#icon-mail&#34;&gt;&lt;/use&gt;&lt;/svg&gt;&lt;/span&gt;&#xA;                    &lt;h3&gt;Email Us&lt;/h3&gt;&#xA;                    &lt;p&gt;For general inquiries and support&lt;/p&gt;&#xA;                    &lt;a href=&#34;mailto:hello@sails.to&#34;&gt;hello@sails.to&lt;/a&gt;&#xA;                &lt;/div&gt;&#xA;                &lt;div class=&#34;contact-card&#34;&gt;&#xA;                    &lt;span class=&#34;icon-wrapper&#34;&gt;&lt;svg&gt;&lt;use href=&#34;#icon-message&#34;&gt;&lt;/use&gt;&lt;/svg&gt;&lt;/span&gt;&#xA;                    &lt;h3&gt;Telegram&lt;/h3&gt;&#xA;                    &lt;p&gt;Join our community or DM us directly&lt;/p&gt;&#xA;                    &lt;a href=&#34;https://t.me/sailsto&#34; target=&#34;_blank&#34;&gt;@sailsto&lt;/a&gt;&#xA;                &lt;/div&gt;&#xA;                &lt;div class=&#34;contact-card&#34;&gt;&#xA;                    &lt;span class=&#34;icon-wrapper&#34;&gt;&lt;svg&gt;&lt;use href=&#34;#icon-briefcase&#34;&gt;&lt;/use&gt;&lt;/svg&gt;&lt;/span&gt;&#xA;                    &lt;h3&gt;LinkedIn&lt;/h3&gt;&#xA;                    &lt;p&gt;Follow us for updates and announcements&lt;/p&gt;&#xA;                    &lt;a href=&#34;https://linkedin.com/company/sailsto&#34; target=&#34;_blank&#34;&gt;/company/sailsto&lt;/a&gt;&#xA;                &lt;/div&gt;&#xA;                &lt;div class=&#34;contact-card&#34;&gt;&#xA;                    &lt;span class=&#34;icon-wrapper&#34;&gt;&lt;svg&gt;&lt;use href=&#34;#icon-send&#34;&gt;&lt;/use&gt;&lt;/svg&gt;&lt;/span&gt;&#xA;                    &lt;h3&gt;Twitter/X&lt;/h3&gt;&#xA;                    &lt;p&gt;Quick updates and industry commentary&lt;/p&gt;&#xA;                    &lt;a href=&#34;https://x.com/sailsto&#34; target=&#34;_blank&#34;&gt;@sailsto&lt;/a&gt;&#xA;                &lt;/div&gt;&#xA;                &lt;div class=&#34;contact-divider&#34;&gt;&lt;/div&gt;&#xA;                &lt;div class=&#34;contact-address&#34;&gt;&#xA;                    &lt;h4&gt;Registered Address&lt;/h4&gt;&#xA;                    &lt;address&gt;&#xA;                        Sails.to DAO LLC&lt;br&gt;&#xA;                        1712 Pioneer Ave, Suite 500&lt;br&gt;&#xA;                        Cheyenne, WY 82001&lt;br&gt;&#xA;                        United States&#xA;                    &lt;/address&gt;&#xA;                &lt;/div&gt;&#xA;                &lt;div class=&#34;contact-hours&#34;&gt;&#xA;                    &lt;h4&gt;Response Time&lt;/h4&gt;&#xA;                    &lt;p&gt;We typically respond within 24 hours during business days (Monday–Friday, 9:00–18:00 CET).&lt;/p&gt;</description>
