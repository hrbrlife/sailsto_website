# LLM Audit Environment Variables Template
# CCASH Document Audit System
#
# Copy this file to .env and fill in your API keys
# DO NOT commit .env to version control

# OpenRouter API Key (for Grok 4.1 fast and other models)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: OpenAI API Key (if using OpenAI directly)
# OPENAI_API_KEY=sk-...

# Optional: Anthropic API Key (if using Anthropic directly)
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: Local LLM / vLLM settings
# LOCAL_LLM_BASE_URL=http://localhost:8000/v1
# LOCAL_LLM_API_KEY=not-needed
