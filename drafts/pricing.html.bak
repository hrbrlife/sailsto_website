    <!-- HERO -->
    <div class="page-hero">
        <h1>💰 Transparent Pricing</h1>
        <p>No hidden fees. No surprises. Calculate your costs before you start.</p>
    </div>

    <!-- MAIN CONTENT -->
    <div class="pricing-container">
        
        <!-- CALCULATOR -->
        <div class="calculator-section">
            <h2>Cost Calculator</h2>
            <p class="intro">Calculate your total costs based on offering size and term</p>
            
            <div class="calc-grid">
                <div class="calc-inputs">
                    <div class="input-group">
                        <label for="userType">I am a...</label>
                        <select id="userType">
                            <option value="issuer">Issuer (raising capital)</option>
                            <option value="investor">Investor (deploying capital)</option>
                        </select>
                    </div>

                    <div class="input-group">
                        <label for="offeringSize">Offering Size</label>
                        <input type="number" id="offeringSize" value="1000000" min="0" step="10000">
                        <span class="input-hint">Total amount you plan to raise/invest</span>
                    </div>

                    <div class="input-group" id="termGroup">
                        <label for="termYears">Term (Years)</label>
                        <input type="number" id="termYears" value="3" min="1" max="30" step="1">
                        <span class="input-hint">Length of the bond</span>
                    </div>

                    <div class="input-group" id="couponGroup">
                        <label for="couponRate">Annual Coupon Rate (%)</label>
                        <input type="number" id="couponRate" value="8" min="0" max="30" step="0.1">
                        <span class="input-hint">Annual interest rate</span>
                    </div>
                </div>

                <div class="calc-results" id="results">
                    <!-- Results populated by JavaScript -->
                </div>
            </div>
        </div>

        <!-- PRICING TIERS -->
        <div class="pricing-tiers">
            <!-- ISSUER PRICING -->
            <div class="pricing-card">
                <h2>For Issuers</h2>
                <p class="subtitle">Raise capital with confidence</p>
                <div class="price-display">$2,500</div>
                <p class="price-period">One-time setup + 0.5% annual</p>
                <ul class="features-list">
                    <li>Full platform access</li>
                    <li>Regulatory compliance support</li>
                    <li>KYC/AML verification</li>
                    <li>Investor relations dashboard</li>
                    <li>Payment distribution automation</li>
                    <li>Prospectus hosting & distribution</li>
                    <li>Dedicated support</li>
                </ul>
                <a href="signup.html" class="cta-button">Start Raising</a>
            </div>

            <!-- INVESTOR PRICING -->
            <div class="pricing-card">
                <h2>For Investors</h2>
                <p class="subtitle">Grow your portfolio</p>
                <div class="price-display">$0</div>
                <p class="price-period">Free to browse and invest</p>
                <ul class="features-list">
                    <li>Access to all bond offerings</li>
                    <li>Real-time portfolio tracking</li>
                    <li>Automated payment collection</li>
                    <li>Document vault</li>
                    <li>Secondary market access</li>
                    <li>Tax reporting tools</li>
                    <li>Email support</li>
                </ul>
                <a href="signup.html" class="cta-button">Start Investing</a>
            </div>

            <!-- BROKER/INSTITUTION PRICING -->
            <div class="pricing-card">
                <h2>For Brokers & Institutions</h2>
                <p class="subtitle">White-label & API access</p>
                <div class="price-display">Custom</div>
                <p class="price-period">Tailored to your needs</p>
                <ul class="features-list">
                    <li>White-label platform</li>
                    <li>Full API access</li>
                    <li>Custom integrations</li>
                    <li>Multi-entity management</li>
                    <li>Bulk operations</li>
                    <li>Priority support</li>
                    <li>Dedicated account manager</li>
                </ul>
                <a href="company/contact.html" class="cta-button">Contact Sales</a>
            </div>
        </div>

        <!-- COMPARISON TABLE -->
        <div class="comparison-section">
            <h2>How We Compare</h2>
            <p class="intro">Sails.to vs. traditional capital markets infrastructure</p>
            
            <table class="comparison-table">
                <thead>
                    <tr>
                        <th>Feature</th>
                        <th>Sails.to</th>
                        <th>Traditional Banks</th>
                        <th>Private Markets</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Setup Fee</td>
                        <td>$2,500</td>
                        <td>$50,000 - $250,000</td>
                        <td>$10,000 - $100,000</td>
                    </tr>
                    <tr>
                        <td>Annual Platform Fee</td>
                        <td>0.5% of offering</td>
                        <td>1.5% - 3.5%</td>
                        <td>2% - 4%</td>
                    </tr>
                    <tr>
                        <td>Minimum Offering</td>
                        <td>$100,000</td>
                        <td>$10,000,000+</td>
                        <td>$500,000+</td>
                    </tr>
                    <tr>
                        <td>Time to Market</td>
                        <td>2-4 weeks</td>
                        <td>3-6 months</td>
                        <td>1-3 months</td>
                    </tr>
                    <tr>
                        <td>Investor Access</td>
                        <td>Global</td>
                        <td>Regional</td>
                        <td>Limited network</td>
                    </tr>
                    <tr>
                        <td>Secondary Market</td>
                        <td>Built-in</td>
                        <td>Limited</td>
                        <td>No</td>
                    </tr>
                    <tr>
                        <td>Payment Automation</td>
                        <td>✓ Included</td>
                        <td>✓ Extra fees</td>
                        <td>✗ Manual</td>
                    </tr>
                </tbody>
            </table>
        </div>

    </div>

    <!-- FOOTER -->
    <footer class="footer">
        <div class="footer-container">
            <div class="footer-col">
