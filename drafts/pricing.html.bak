<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pricing | Sails.to</title>
    <meta name="description" content="Transparent pricing for issuers and investors. Calculate your costs with our interactive calculator.">
    <meta name="keywords" content="pricing, fees, bond pricing, issuance costs, capital raising fees">
    
    <!-- Open Graph -->
    <meta property="og:title" content="Sails.to Pricing">
    <meta property="og:description" content="Transparent pricing with interactive calculator.">
    <meta property="og:image" content="https://sails.to/assets/og-image.png">
    <meta property="og:url" content="https://sails.to/pricing.html">
    <meta property="og:type" content="website">
    
    <link rel="stylesheet" href="assets/fonts/fonts.css">
    <link rel="stylesheet" href="styles.css">
    <style>
        :root {
            --primary: #3182ce;
            --ink: #1a202c;
            --slate: #64748b;
            --silver: #94a3b8;
            --border: #e2e8f0;
            --cream: #fafaf9;
            --success: #38a169;
        }

        .page-hero {
            background: linear-gradient(135deg, #1a202c 0%, #2d3748 100%);
            padding: 100px 30px 60px;
            text-align: center;
        }

        .page-hero h1 {
            color: white;
            font-size: 2.5rem;
            margin-bottom: 16px;
            font-weight: 800;
        }

        .page-hero p {
            color: rgba(255,255,255,0.7);
            font-size: 1.1rem;
            max-width: 600px;
            margin: 0 auto;
        }

        .pricing-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 60px 30px;
            background: white;
        }

        /* FEE TABLE */
        .fee-table-section {
            margin-bottom: 60px;
        }

        .fee-table-section h2 {
            font-size: 2rem;
            margin-bottom: 12px;
            color: var(--ink);
        }

        .fee-table-section .intro {
            color: var(--slate);
            margin-bottom: 30px;
            line-height: 1.6;
        }

        .fee-table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            margin-bottom: 30px;
        }

        .fee-table th,
        .fee-table td {
            padding: 16px 20px;
            text-align: left;
            border-bottom: 1px solid var(--border);
        }

        .fee-table thead {
            background: var(--ink);
            color: white;
        }

        .fee-table th {
            font-weight: 600;
            font-size: 0.9rem;
        }

        .fee-table tbody tr:hover {
            background: var(--cream);
        }

        .fee-table tbody tr:last-child td {
            border-bottom: none;
        }

        .fee-table td:first-child {
            font-weight: 600;
            color: var(--ink);
        }

        .fee-amount {
            color: var(--primary);
            font-weight: 700;
            font-size: 1.1rem;
        }

        .indented {
            padding-left: 40px !important;
            font-weight: 400 !important;
        }

        .total-row {
            background: #f0f4ff !important;
            font-weight: 700 !important;
        }

        .total-row td {
            font-style: italic;
            text-align: center;
        }

        /* INFO BOXES */
        .info-box {
            background: rgba(49, 130, 206, 0.08);
            border-left: 4px solid var(--primary);
            padding: 20px 25px;
            border-radius: 0 8px 8px 0;
            margin: 30px 0;
        }

        .info-box h4 {
            margin-top: 0;
            margin-bottom: 12px;
            color: var(--ink);
        }

        .info-box p {
            margin: 0;
            color: var(--slate);
            line-height: 1.6;
        }

        .info-box ul {
            margin: 12px 0 0 0;
            padding-left: 20px;
            color: var(--slate);
        }

        .info-box li {
            margin: 8px 0;
        }

        /* CALCULATOR */
        .calculator-section {
            background: var(--cream);
            border-radius: 12px;
            padding: 40px;
            margin-bottom: 60px;
        }

        .calculator-section h2 {
            font-size: 2rem;
            margin-bottom: 12px;
            color: var(--ink);
        }

        .calculator-section .intro {
            color: var(--slate);
            margin-bottom: 40px;
        }

        .calc-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
        }

        @media (max-width: 768px) {
            .calc-grid {
                grid-template-columns: 1fr;
            }
        }

        .calc-inputs {
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .input-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .input-group label {
            font-weight: 600;
            color: var(--ink);
            font-size: 0.9rem;
        }

        .input-group input,
        .input-group select {
            padding: 12px 16px;
            border: 2px solid var(--border);
            border-radius: 8px;
            font-size: 1rem;
            transition: all 0.2s ease;
            background: white;
        }

        .input-group input:focus,
        .input-group select:focus {
            outline: none;
            border-color: var(--primary);
        }

        .input-hint {
            font-size: 0.8rem;
            color: var(--silver);
        }

        .calc-results {
            background: white;
            border-radius: 12px;
            padding: 30px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .result-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid var(--border);
        }

        .result-row:last-child {
            border-bottom: none;
        }

        .result-label {
            font-size: 0.95rem;
            color: var(--slate);
        }

        .result-value {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--ink);
        }

        .result-highlight {
            background: rgba(49, 130, 206, 0.08);
            padding: 20px;
            border-radius: 8px;
            margin-top: 16px;
            border: 2px solid var(--primary);
        }

        .result-highlight .result-label {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--ink);
        }

        .result-highlight .result-value {
            font-size: 1.8rem;
            color: var(--primary);
        }
    </style>
</head>
