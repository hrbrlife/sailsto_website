    <!-- CALCULATOR SCRIPT -->
    <script>
        const userTypeSelect = document.getElementById('userType');
        const offeringSizeInput = document.getElementById('offeringSize');
        const termYearsInput = document.getElementById('termYears');
        const couponRateInput = document.getElementById('couponRate');
        const resultsDiv = document.getElementById('results');
        const termGroup = document.getElementById('termGroup');
        const couponGroup = document.getElementById('couponGroup');

        function formatCurrency(amount) {
            return new Intl.NumberFormat('en-US', {
                style: 'currency',
                currency: 'USD',
                minimumFractionDigits: 0,
                maximumFractionDigits: 0
            }).format(amount);
        }

        function formatPercent(percent) {
            return percent.toFixed(2) + '%';
        }

        function calculateCosts() {
            const userType = userTypeSelect.value;
            const offeringSize = parseFloat(offeringSizeInput.value) || 0;
            const termYears = parseFloat(termYearsInput.value) || 3;
            const couponRate = parseFloat(couponRateInput.value) || 8;

            let html = '';

            if (userType === 'issuer') {
                // Show issuer-relevant fields
                termGroup.style.display = 'flex';
                couponGroup.style.display = 'flex';

                const setupFee = 2500;
                const annualPlatformFee = offeringSize * 0.005; // 0.5%
                const totalPlatformFees = setupFee + (annualPlatformFee * termYears);
                
                const annualInterest = offeringSize * (couponRate / 100);
                const totalInterestPayments = annualInterest * termYears;
                
                const totalCost = totalPlatformFees + totalInterestPayments;
                const effectiveCostRate = (totalCost / offeringSize) / termYears * 100;

                html = `
                    <div class="result-row">
                        <span class="result-label">Setup Fee</span>
                        <span class="result-value">${formatCurrency(setupFee)}</span>
                    </div>
                    <div class="result-row">
                        <span class="result-label">Annual Platform Fee</span>
                        <span class="result-value">${formatCurrency(annualPlatformFee)}</span>
                    </div>
                    <div class="breakdown-section">
                        <h4>Total Over ${termYears} Years</h4>
                        <div class="result-row">
                            <span class="result-label">Platform Fees</span>
                            <span class="result-value">${formatCurrency(totalPlatformFees)}</span>
                        </div>
                        <div class="result-row">
                            <span class="result-label">Interest Payments</span>
                            <span class="result-value">${formatCurrency(totalInterestPayments)}</span>
                        </div>
                    </div>
                    <div class="result-row">
                        <span class="result-label">Total Cost of Capital</span>
                        <span class="result-value">${formatCurrency(totalCost)}</span>
                    </div>
                    <div class="result-row" style="border-top: none; margin-top: 0; padding-top: 12px;">
                        <span class="result-label">Effective Annual Rate</span>
                        <span class="result-value">${formatPercent(effectiveCostRate)}</span>
                    </div>
                `;
            } else {
                // Investor view - simplified
                termGroup.style.display = 'none';
                couponGroup.style.display = 'none';

                html = `
                    <div class="result-row">
                        <span class="result-label">Platform Fee</span>
                        <span class="result-value">${formatCurrency(0)}</span>
                    </div>
                    <div class="result-row">
                        <span class="result-label">Transaction Fee</span>
                        <span class="result-value">${formatCurrency(0)}</span>
                    </div>
                    <div class="result-row">
                        <span class="result-label">Annual Management Fee</span>
                        <span class="result-value">${formatCurrency(0)}</span>
                    </div>
                    <div class="result-row">
                        <span class="result-label">Total Cost</span>
                        <span class="result-value">${formatCurrency(0)}</span>
                    </div>
                    <div style="margin-top: 20px; padding: 16px; background: #e6fffa; border-radius: 8px; text-align: center;">
                        <p style="color: #2c7a7b; font-weight: 600; margin: 0;">
                            ✓ Free for investors<br>
                            <span style="font-size: 0.85rem; font-weight: 400;">You keep 100% of your returns</span>
                        </p>
                    </div>
                `;
            }

            resultsDiv.innerHTML = html;
        }

        // Event listeners
        userTypeSelect.addEventListener('change', calculateCosts);
        offeringSizeInput.addEventListener('input', calculateCosts);
        termYearsInput.addEventListener('input', calculateCosts);
        couponRateInput.addEventListener('input', calculateCosts);

        // Initial calculation
        calculateCosts();
    </script>
